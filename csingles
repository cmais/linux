# Update e Upgrade Juntos
sudo apt update && sudo apt upgrade -y

# Repara Instalação Corropida
sudo dpkg --configure -a

# LISTA AS CONEXÕES DISPONIVEIS
nmcli dev wifi list

# Remove Chaveiro
sudo apt-get remove gnome-keyring
sudo apt-get remove --auto-remove gnome-keyring

# Desabilida proteção de tela no mint xfce
mkdir -p ~/.config/autostart
cat > ~/.config/autostart/disable-screen-blank.desktop << 'EOF'
[Desktop Entry]
Type=Application
Name=Disable Screen Blank
Exec=sh -c "xset -dpms && xset s off && xset s noblank"
StartupNotify=false
Terminal=false
EOF

# Verifica o Estado Atual
xset q

# Lista Programas Instalados
sudo dpkg -l

# Exibe a Quantidade de RAM e o Tipo ex: DDR4
sudo lshw -short -C memory

# Mint todos os wallpapers
sudo apt install mint-backgrounds-*

# Luanti - Instalação
sudo apt update && sudo apt install luanti


# Exibe o nome do disco
lsblk -o NAME,SIZE,MODEL,TRAN,TYPE

# Somente leitura
sudo badblocks -v /dev/sdX

# Leitura e escrita nao destrutiva
sudo badblocks -vn /dev/sdX
